general {
  colors = true
  output_format = "i3bar"
  interval = 1
  markup = "pango"
}

order += "volume master"
order += "run_watch VPN"
order += "memory"
order += "load"
order += "wireless _first_"
order += "tztime local"

volume master {
    format = "♪: %volume"
    format_muted = "%volume"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

memory {
    format = "ram: %used"
    threshold_degraded = "10%"
    format_degraded = "MEMORY: %free"
}

load {
    format = "cpu : %1min"
}



wireless _first_ {
    format_up = "<span color='#FFFFFF'> %essid (%quality, %bitrate) </span>"
    format_down = "W: down"
}



tztime local {
    
	  align = "center"
    format =   "%a %d %b %Y |<span color='#74B9A1'> %I:%M%p </span>"
}

run_watch VPNC {
        # file containing the PID of a vpnc process
        pidfile = "/var/run/vpnc/pid"
}

path_exists VPN {
        # path exists when a VPN tunnel launched by nmcli/nm-applet is active
        path = "/proc/sys/net/ipv4/conf/tun0"
}


